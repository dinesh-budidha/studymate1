# StudyMate Configuration Template
# Copy this file to .env and fill in your API keys

# HuggingFace API Key (optional, for advanced models)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# IBM Watson Text-to-Speech (optional, for advanced TTS)
IBM_WATSON_API_KEY=your_ibm_watson_api_key_here
IBM_WATSON_URL=your_ibm_watson_service_url_here

# You can get these from:
# - HuggingFace: https://huggingface.co/settings/tokens
# - IBM Watson: https://cloud.ibm.com/catalog/services/text-to-speech